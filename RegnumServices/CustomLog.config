<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwExceptions="false">

	<!-- Define variables if needed -->
	<variable name="logDirectory" value="${basedir}/custom-logs" />

	<targets>
		<!-- Log to a file -->
		<target xsi:type="File" name="fileLogger"
				fileName="${logDirectory}/custom-log-${shortdate}.log"
				layout="${longdate}|${uppercase:${level}}|${message}|${exception:format=tostring}" />

		<!-- Log to the console -->
		<target xsi:type="Console" name="consoleLogger"
				layout="${longdate}|${level}|${message}|${exception}" />
	</targets>

	<rules>
		<!-- Log everything to file -->
		<logger name="*" minlevel="Debug" writeTo="fileLogger" />
		<!-- Log warnings and above to console -->
		<logger name="*" minlevel="Warn" writeTo="consoleLogger" />
	</rules>
</nlog>
